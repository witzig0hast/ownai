{$DOMAIN} {
	# Empfehlung: Server nur über Tailscale/WireGuard erreichbar machen (siehe DECISIONS.md #2).
	# Läuft DOMAIN öffentlich, sorgt Caddy hier automatisch für ein Let's-Encrypt-Zertifikat.

	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}
}
