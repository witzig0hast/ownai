# Kopieren nach .env und Werte anpassen. .env NIEMALS committen.

# --- Postgres ---
POSTGRES_USER=ownai
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ownai
DATABASE_URL=postgresql+asyncpg://ownai:change-me-strong-password@postgres:5432/ownai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend / Auth ---
# 32+ zufällige Bytes, z.B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Ollama ---
# OwnAI bringt keinen eigenen Ollama-Container mit — es verbindet sich mit einer
# Ollama-Instanz, die du selbst auf diesem Server betreibst (systemd-Install oder eigener
# Container). Siehe infra/ollama/README.md.
# host.docker.internal erreicht den Host von den OwnAI-Containern aus (Linux: dafür ist
# extra_hosts im backend-Service in docker-compose.yml konfiguriert). Läuft dein Ollama
# auf einem anderen Port/Rechner, hier die echte Adresse eintragen.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=hermes3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Ports (Host-seitig, 0.0.0.0 — überall im Netz/Tailnet erreichbar) ---
# Anpassen, falls die Defaults auf deinem Server schon belegt sind
# (prüfen mit: ss -tlnp | awk '{print $4}' | grep -oE '[0-9]+$' | sort -n -u).
BACKEND_PORT=8000
WEB_PORT=3000

# Adresse, unter der DEIN BROWSER das Backend erreicht — muss zu BACKEND_PORT und der
# Adresse passen, über die du den Server ansprichst (LAN-IP, Tailscale-Hostname, ...).
# Nur relevant, wenn du Backend/Web DIREKT per IP:Port nutzt statt über Caddy mit Domain.
# Beispiel bei direktem Zugriff:
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.50:8000/api/v1
# Läuft alles über Caddy+DOMAIN (Standard, siehe unten): diese Zeile auskommentiert lassen,
# der Default https://${DOMAIN}/api/v1 greift dann automatisch.
# NEXT_PUBLIC_API_BASE_URL=

# --- CORS (Web-App-Origin) ---
# Muss zur tatsächlichen Origin passen, unter der du die Web-App im Browser öffnest
# (Protokoll+Host+WEB_PORT) — sonst blockt der Browser die Requests ans Backend.
# Bei direktem Zugriff z.B.: CORS_ORIGINS=http://192.168.1.50:3000
# Mehrere Origins kommagetrennt möglich.
CORS_ORIGINS=http://localhost:3000

# --- Domain (für Caddy TLS, nur falls du über Caddy statt direktem IP:Port gehst) ---
DOMAIN=ownai.example.internal
