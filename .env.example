# Kopieren nach .env und Werte anpassen. .env NIEMALS committen.

# --- Postgres ---
POSTGRES_USER=ownai
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ownai
DATABASE_URL=postgresql+asyncpg://ownai:change-me-strong-password@postgres:5432/ownai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend / Auth ---
# 32+ zufällige Bytes, z.B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Ollama ---
# Default: nutzt eine bereits vorhandene Ollama-Instanz auf diesem Server (systemd-Install
# oder eigener Container), erreichbar über den Host. Siehe infra/ollama/README.md.
# Läuft dein Ollama NICHT auf localhost:11434 des Servers (z.B. anderer Port, anderer
# Rechner im Netz), hier die echte Adresse eintragen.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Nutzt du stattdessen den mitgelieferten Ollama-Service aus docker-compose.yml
# (`docker compose --profile bundled-ollama up -d ollama`), stattdessen:
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=hermes3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Nur relevant für den mitgelieferten Ollama-Service (--profile bundled-ollama) — begrenzt
# VRAM-Nutzung: nur 1 Modell gleichzeitig geladen, entlädt nach 10 Minuten Inaktivität.
# Läuft dein eigenes Ollama bereits, konfigurier das dort (z.B. systemd-Environment).
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=10m

# --- CORS (Web-App-Origin) ---
CORS_ORIGINS=http://localhost:3000

# --- Domain (für Caddy TLS) ---
DOMAIN=ownai.example.internal
