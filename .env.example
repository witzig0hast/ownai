# Kopieren nach .env und Werte anpassen. .env NIEMALS committen.

# --- Postgres ---
POSTGRES_USER=ownai
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ownai
DATABASE_URL=postgresql+asyncpg://ownai:change-me-strong-password@postgres:5432/ownai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend / Auth ---
# 32+ zufällige Bytes, z.B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=hermes3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Begrenzt VRAM-Nutzung: nur 1 Modell gleichzeitig geladen, entlädt nach 10 Minuten Inaktivität
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=10m

# --- CORS (Web-App-Origin) ---
CORS_ORIGINS=http://localhost:3000

# --- Domain (für Caddy TLS) ---
DOMAIN=ownai.example.internal
