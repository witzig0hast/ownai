<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the OwnAI backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice input: recording a clip for POST /voice/transcribe. Requested at runtime
         (see ChatThreadScreen) when the mic button is first tapped, not on app start. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Required on API 33+ for the app to post its own notifications - used for the
         "Timer abgelaufen" alert (see alarm/TimerAlarmReceiver.kt), requested up front on
         NotificationAccessScreen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets a set timer (see alarm/TimerAlarmScheduler.kt) fire at the exact moment it's due
         rather than being deferred by Doze battery optimization. Falls back to an inexact alarm
         if the OS doesn't grant this (canScheduleExactAlarms() check at schedule time) - a timer
         still fires either way, just possibly a bit late without it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- NOTE: android.permission.READ_SMS / RECEIVE_SMS are intentionally NOT
         requested here. See README.md ("SMS nuance") for why raw SMS capture
         is out of scope for v1 and what it would take to add later. -->

    <!-- android:usesCleartextTraffic="true" below: apps targeting API 28+ block plain
         http:// by default. This is a personal app talking only to your own self-hosted
         backend (no arbitrary third-party traffic), and the base URL is a plain IP/
         Tailscale hostname without TLS until Caddy is set up (see root GETTING_STARTED.md
         step 6) - without this the app cannot reach the backend at all. -->

    <application
        android:name=".OwnAiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OwnAI"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OwnAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Core Android-specific feature: reads notifications posted by other apps
             (with the user's explicit "Notification access" grant, see
             NotificationAccessScreen) and forwards relevant ones to the backend. -->
        <service
            android:name=".notification.NotificationForwardingService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fires the "Timer abgelaufen" notification when a scheduled timer expires (see
             alarm/TimerAlarmScheduler.kt) - not exported, only this app schedules it. -->
        <receiver
            android:name=".alarm.TimerAlarmReceiver"
            android:exported="false" />

    </application>

</manifest>
