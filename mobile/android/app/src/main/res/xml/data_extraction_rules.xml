<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) equivalent of backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ownai_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ownai_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
